<?xml version="1.0" encoding="utf-8"?>
<!--
  与 DouyinDownloader 对齐的配色 token。
  下载器的设计说明在它的 DESIGN.md：暖橙 #FF7A3A + 纸色 #F2EFEB / #141210。

  传统 View 里做不出真 backdrop blur（跨层采样），卡片用「半透明 + 细描边」模拟玻璃：
  背景有内容时能微微透出来，而不是一块死色。
-->
<resources>
    <!-- 背景 / 卡片 -->
    <color name="bg_base">#F2EFEB</color>
    <color name="bg_glow_warm">#40FF7A3A</color>
    <color name="card_fill">#B8FFFFFF</color>
    <color name="card_stroke">#14000000</color>
    <color name="card_fill_sunken">#66000000</color>

    <!-- 强调 -->
    <color name="accent">#FF7A3A</color>
    <color name="accent_soft">#33FF7A3A</color>
    <color name="accent_ink">#FFFFFF</color>

    <!-- 文字 -->
    <color name="text_primary">#1A1614</color>
    <color name="text_secondary">#6B6560</color>
    <color name="text_tertiary">#9C948E</color>

    <!-- 组件 -->
    <color name="input_fill">#8CFFFFFF</color>
    <color name="input_stroke">#1A000000</color>
    <color name="divider">#12000000</color>
    <color name="chip_idle">#66FFFFFF</color>
    <color name="chip_active">#FF7A3A</color>
    <color name="status_ok">#2E9E6B</color>
    <color name="status_warn">#C97A2B</color>

    <!-- 系统栏 -->
    <color name="system_bar">#F2EFEB</color>
    <color name="system_bar_icon_light">#00000000</color>
</resources>
